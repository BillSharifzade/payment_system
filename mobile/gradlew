#!/bin/sh
# Minimal Gradle wrapper launcher: hands off to GradleWrapperMain, which reads
# gradle/wrapper/gradle-wrapper.properties, downloads the pinned distribution on
# first run, and executes the build. Requires `java` on PATH (JDK 17+).
APP_HOME=$(cd "$(dirname "$0")" && pwd)
exec java -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain "$@"
