<?xml version="1.0" encoding="utf-8"?>
<!-- Default (prod): no cleartext, ever. The dev flavor overrides this file to
     allow HTTP to the emulator's host loopback only; the staging flavor uses a
     config GENERATED from its API_BASE_URL (cleartext to that one host only —
     see app/build.gradle.kts, StagingNetworkSecurityConfigTask).

     Certificate pinning (hardening item S1) is NOT configured here: a <pin-set>
     cannot take build-time values. It is enforced by OkHttp's CertificatePinner
     in ApiClient, from BuildConfig.CERT_PINS (-PpaymentCertPins=sha256/…,sha256/…:
     the live key AND an offline backup key). A prod release refuses to package
     without pins and refuses to start without them; see data/CertificatePins.kt
     for how to compute a pin. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
