# Copy to deploy/.env and fill in. `./deploy.sh` will generate the secrets for
# you if .env does not exist. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Environment ---
# Any value other than "dev" makes the server refuse to boot on insecure
# defaults (it will require JWT_SECRET >= 32 chars and DATABASE_URL).
APP_ENV=prod
RUST_LOG=info
BIND_ADDR=0.0.0.0:8080

# Public site address for Caddy. A bare domain enables automatic HTTPS.
# Use ":80" only for a throwaway IP-based smoke test.
SITE_ADDRESS=:80

# --- Secrets (GENERATE THESE — see deploy.sh) ---
POSTGRES_PASSWORD=CHANGE_ME
# >= 32 chars. Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# 32 bytes hex (64 chars) — Ed25519 seed for checkpoint signing. Generate: openssl rand -hex 32
# If this changes, previously-sealed checkpoints won't verify — keep it stable & backed up.
WORKER_SIGNING_KEY=CHANGE_ME

# --- Wiring (internal Docker network names; usually leave as-is) ---
DATABASE_URL=postgres://payment:${POSTGRES_PASSWORD}@postgres:5432/payment
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222

# --- Behind the Caddy proxy, trust its X-Forwarded-For for rate-limit identity ---
TRUST_PROXY=true

# --- Rate limiting (per client per window) ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECS=60
# Login attempts per PHONE per window (anti credential-stuffing; independent of
# the per-IP limiter above).
LOGIN_LIMIT_MAX=10
LOGIN_LIMIT_WINDOW_SECS=900

# --- Database pool (per API instance) ---
DB_MAX_CONNECTIONS=32

# --- Fees ---
TRANSFER_FEE_BPS=0        # e.g. 50 = 0.50%

# --- AML limits, in minor units (diram; 100 = 1 TJS). Unset => compiled defaults. ---
# Level 1 (basic KYC)
AML_L1_PER_TX_MINOR=500000
AML_L1_DAILY_MINOR=2000000
AML_L1_VELOCITY_PER_HOUR=50
# Level 2 (full KYC)
AML_L2_PER_TX_MINOR=50000000
AML_L2_DAILY_MINOR=200000000
AML_L2_VELOCITY_PER_HOUR=500

# --- Workers ---
WORKER_INTERVAL_SECS=5
SEAL_BATCH_SIZE=500
# Independent cadences for the heavier passes (seconds).
RECONCILE_INTERVAL_SECS=60
VERIFY_INTERVAL_SECS=300
RETENTION_INTERVAL_SECS=86400
# Retention windows (days) for operational tables. The ledger itself and the
# compliance audit trail (screening_events) are never pruned.
RETENTION_OUTBOX_DAYS=7
RETENTION_IDEMPOTENCY_DAYS=30
RETENTION_REFRESH_TOKENS_DAYS=30
# Uploaded KYC documents never cited by any submission are deleted after this
# many days (documents referenced by a submission are kept forever).
RETENTION_KYC_ORPHAN_DAYS=7

# --- KYC uploads ---
# Per-user document upload quota (rolling 24h).
KYC_UPLOAD_DAILY_MAX=20
