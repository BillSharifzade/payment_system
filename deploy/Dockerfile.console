# Admin console + edge proxy image (payment-console).
#
# Stage 1 builds the React SPA exactly like CI does (lockfile-exact `npm ci`,
# then `npm run build` = tsc + vite). Stage 2 is the Caddy that serves it at
# /admin and reverse-proxies /v1, /health and /ready to payment-server. Node is
# therefore NOT needed on the host any more, and the console ships as an image
# (docker save | docker load) instead of a bind-mounted dist/ directory.
#
# Build context is the REPO ROOT (needs console/ and deploy/Caddyfile; the root
# .dockerignore keeps everything else out):
#   docker build -f deploy/Dockerfile.console -t payment-console:<tag> .
# Legacy-builder compatible (no BuildKit-only syntax). Base images are pinned
# by digest; refresh with scripts/image-digest.sh <image:tag> when bumping.

# ---- build the SPA ------------------------------------------------------
FROM node:22.23.3-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
# NODE_ENV must NOT be "production" here: vite and typescript are devDependencies.
COPY console/package.json console/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY console/ ./
RUN npm run build

# ---- edge -------------------------------------------------------------
FROM caddy:2.11.7@sha256:f2a1290d0463aad60660d4ec134943f183ee2a5f6c3eb7bf32dd984f2f020772
# The Caddyfile is baked in; SITE_ADDRESS / ADMIN_ALLOW_CIDR / API_UPSTREAMS
# are read from the environment when Caddy starts (see the compose files).
# Editing the Caddyfile therefore means rebuilding this (fast, cached) image:
# `./deploy.sh`.
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/admin
# Fail the build early if the Caddyfile does not parse.
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

# Run as an unprivileged user with no capabilities at all. The upstream image
# gives the binary a cap_net_bind_service FILE capability so root-less binds
# below 1024 work; with every capability dropped (compose) the kernel refuses
# to exec a binary whose file capabilities it cannot grant, so it is removed.
# Binding 80/443 instead relies on net.ipv4.ip_unprivileged_port_start=0 in
# the container's network namespace (set by the compose files; Docker's
# default since 20.10). /data (certificates, internal CA, access log) and
# /config must be writable by that user: existing volumes are chowned once by
# deploy/upgrade-hardening.sh.
RUN setcap -r /usr/bin/caddy \
    && addgroup -S -g 10001 caddy \
    && adduser -S -D -H -u 10001 -G caddy -s /sbin/nologin caddy \
    && mkdir -p /data/caddy /config/caddy \
    && chown -R 10001:10001 /data /config
USER 10001:10001
