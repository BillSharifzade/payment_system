# Admin console + edge proxy image (payment-console).
#
# Stage 1 builds the React SPA exactly like CI does (lockfile-exact `npm ci`,
# then `npm run build` = tsc + vite). Stage 2 is the Caddy that serves it at
# /admin and reverse-proxies /v1, /health and /ready to payment-server. Node is
# therefore NOT needed on the host any more, and the console ships as an image
# (docker save | docker load) instead of a bind-mounted dist/ directory.
#
# Build context is the REPO ROOT (needs console/ and deploy/Caddyfile; the root
# .dockerignore keeps everything else out):
#   docker build -f deploy/Dockerfile.console -t payment-console:<tag> .
# Legacy-builder compatible (no BuildKit-only syntax).

# ---- build the SPA ------------------------------------------------------
FROM node:22.23.2-alpine AS build
WORKDIR /app
# NODE_ENV must NOT be "production" here: vite and typescript are devDependencies.
COPY console/package.json console/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY console/ ./
RUN npm run build

# ---- edge -------------------------------------------------------------
FROM caddy:2.11.4
# The Caddyfile is baked in; SITE_ADDRESS / ADMIN_ALLOW_CIDR are read from the
# environment when Caddy starts (see the compose files). Editing the Caddyfile
# therefore means rebuilding this (fast, cached) image: `./deploy.sh`.
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist /srv/admin
# Fail the build early if the Caddyfile does not parse.
RUN caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
