# Application settings: passed verbatim to payment-server and payment-workers
# (env_file). Copy to deploy/app.env (deploy.sh does this on first run).
#
# Every numeric value is parsed STRICTLY: a typo such as `2_000_000` makes the
# binary refuse to boot instead of silently reverting to a compiled default.
#
# Secrets and connection URLs are NOT here, and must not be: the compose files
# hand them to the binaries as files under /run/secrets via *_FILE variables
# (generated by deploy.sh into deploy/secrets/):
#   payment-server   DATABASE_URL_FILE            runtime role payment_app
#                    MIGRATION_DATABASE_URL_FILE  schema owner payment_owner, used
#                                                 ONLY to run migrations at startup
#                    JWT_SECRET_FILE, REDIS_URL_FILE (authenticated),
#                    BIOMETRIC_TEMPLATE_KEY_FILE
#   payment-workers  DATABASE_URL_FILE, WORKER_SIGNING_KEY_FILE,
#                    WORKER_TRUSTED_PUBLIC_KEYS_FILE, NATS_URL_FILE (authenticated)
# A plain DATABASE_URL / REDIS_URL / NATS_URL / ... line here would WIN over
# the file (the binaries check the plain variable first), so deploy.sh refuses
# to deploy while one is set.
# ---------------------------------------------------------------------------

# --- Environment ---
# Any value other than "dev" makes the binaries refuse insecure defaults (they
# require the secrets above, JWT_SECRET >= 32 chars, NATS_URL for the workers).
APP_ENV=prod
# Per-request access log lines are emitted at INFO (method, path, status, µs).
RUST_LOG=info
BIND_ADDR=0.0.0.0:8080

# --- Wiring ---
# (REDIS_URL / NATS_URL carry credentials now: they come from secret files.)
NATS_SUBJECT_PREFIX=payments

# Behind Caddy, trust its X-Forwarded-For (right-most hop) for the rate-limit
# client identity. Both the public stack and the LAN overlay put Caddy in front
# of every API port, so this stays true; set false only if clients ever reach
# payment-server directly.
TRUST_PROXY=true

# --- Timeouts (milliseconds unless noted). Every wait in the request path is bounded. ---
# Whole-request budget; a timeout answers 504 `timeout` (clients keep their
# idempotency key and retry).
REQUEST_TIMEOUT_SECS=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TX_TIMEOUT_MS=10000
# Connections per API replica (Postgres max_connections=200 in compose; keep
# replicas x DB_MAX_CONNECTIONS + 8 for the workers + headroom below it).
DB_MAX_CONNECTIONS=32

# --- Rate limiting (per client address per window; Redis-shared, in-memory fallback) ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECS=60
# FAILED login attempts per PHONE per window (successful logins are free).
LOGIN_LIMIT_MAX=10
LOGIN_LIMIT_WINDOW_SECS=900
# Recipient look-ups (phone -> wallet) per USER per window (anti-enumeration).
RESOLVE_LIMIT_MAX=60
RESOLVE_LIMIT_WINDOW_SECS=3600

# --- Sessions ---
# A client that rotated its refresh token but lost the response may re-present
# the old token for this many seconds and get a fresh pair. 0 = strict rotation.
REFRESH_REUSE_GRACE_SECS=30
# Device binding of money moves (mobile app): transfers, FX and app check
# payments must carry X-Device-Id + X-Device-Signature from a phone key the user
# registered with their password. required = refuse unsigned requests (the
# default, and the only value accepted outside APP_ENV=dev); optional = verify
# when present (dev); off = ignore (dev).
DEVICE_BINDING=required
# Active registered devices per user (1-100); one more is refused (409).
DEVICE_MAX_ACTIVE=3

# --- Fees (basis points; 50 = 0.50%; max 10000) ---
TRANSFER_FEE_BPS=0

# --- Deposits (admin wallet funding) ---
# Dual control: a deposit is a REQUEST (202 pending_approval) until a second
# admin — not the requester, not the wallet owner — approves it in the console.
# `false` posts immediately and is refused unless APP_ENV=dev.
DEPOSIT_DUAL_CONTROL=true
# Largest single deposit, minor units (100000000 = 1,000,000 TJS); above it the
# API answers 422 limit_exceeded. The monitoring overlay additionally alerts on
# any single deposit above 10,000,000 (deploy/monitoring/prometheus-rules.yml).
DEPOSIT_MAX_MINOR=100000000

# --- Biometric (fingerprint) payments — DESIGN.md §20 ---
# The template sealing key is a generated secret file
# (secrets/biometric_template_key -> BIOMETRIC_TEMPLATE_KEY_FILE). Back it up
# OFF the box: without it every enrolment is unreadable.
#
# Matcher: `exact` (byte-identical template lookup) is a dev/demo stand-in and
# the server REFUSES TO BOOT with it outside APP_ENV=dev — it is also what an
# unset BIOMETRIC_MATCHER means, so keep this line. `http` = a matching-engine
# service implementing the DESIGN.md §20.5 contract at BIOMETRIC_MATCHER_URL.
# This stack ships NO matcher: until you run one (on the `backend` network,
# e.g. as a compose service named biometric-matcher), leave the two lines as
# they are — the API boots and works, only fingerprint enrolment and
# fingerprint payments fail (the matcher call errors). Do not switch to
# `exact` to "make fingerprints work" in production: it cannot match real
# scans and the server refuses it anyway.
BIOMETRIC_MATCHER=http
BIOMETRIC_MATCHER_URL=http://biometric-matcher:8090
BIOMETRIC_MATCHER_TIMEOUT_MS=2000
# 1:N identification (no payer phone on the terminal) widens the false-match
# surface with every enrolment; off by default. When off, terminals must send
# payer_phone (1:1 verification).
BIOMETRIC_IDENTIFY=false
# With BIOMETRIC_IDENTIFY=true, the match threshold grows with the size of the
# searched gallery (more enrolments = more chances of a false match) by this
# factor. Non-negative decimal; 0 disables the scaling (not recommended).
BIOMETRIC_IDENTIFY_SCALE=10
# Failed fingerprint attempts on one check before it is locked and cancelled
# (409 check_locked).
BIOMETRIC_MAX_ATTEMPTS=5
# Decision policy: match iff best score >= threshold and the runner-up (another
# person) is either below the threshold or at least `margin` lower.
BIOMETRIC_MATCH_THRESHOLD=40
BIOMETRIC_MATCH_MARGIN=10
# Cap per fingerprint payment, minor units (200000 = 2000 TJS); AML tiers still apply.
BIOMETRIC_MAX_MINOR=200000
# Merchant check lifetime (default / maximum a terminal may request), seconds.
CHECK_TTL_SECS=300
CHECK_MAX_TTL_SECS=3600

# --- AML limits, in minor units (diram; 100 = 1 TJS). Unset => compiled defaults. ---
# Level 1 (basic KYC)
AML_L1_PER_TX_MINOR=500000
AML_L1_DAILY_MINOR=2000000
AML_L1_VELOCITY_PER_HOUR=50
# Level 2 (full KYC)
AML_L2_PER_TX_MINOR=50000000
AML_L2_DAILY_MINOR=200000000
AML_L2_VELOCITY_PER_HOUR=500

# --- Workers ---
WORKER_INTERVAL_SECS=5
# Outbox -> NATS JetStream relay cadence (its own task; a slow broker never
# blocks sealing or reconciliation).
RELAY_INTERVAL_SECS=2
SEAL_BATCH_SIZE=500
# Incremental reconciliation (accounts touched since the last healthy pass)
# every RECONCILE_INTERVAL_SECS; a FULL re-derivation of every account every
# RECONCILE_FULL_EVERY_SECS (default daily).
RECONCILE_INTERVAL_SECS=60
RECONCILE_FULL_EVERY_SECS=86400
# Checkpoint-chain verification: incremental every VERIFY_INTERVAL_SECS, and a
# FULL re-verification from genesis (against WORKER_TRUSTED_PUBLIC_KEYS_FILE)
# every VERIFY_FULL_EVERY_SECS (default 6 h).
VERIFY_INTERVAL_SECS=300
VERIFY_FULL_EVERY_SECS=21600
RETENTION_INTERVAL_SECS=86400
# Retention windows (days) for operational tables. The ledger itself and the
# compliance audit trails (screening_events, admin_actions) are never pruned.
RETENTION_OUTBOX_DAYS=7
RETENTION_IDEMPOTENCY_DAYS=30
RETENTION_REFRESH_TOKENS_DAYS=30
# Uploaded KYC documents never cited by any submission are deleted after this
# many days (documents referenced by a submission are kept forever).
RETENTION_KYC_ORPHAN_DAYS=7

# --- External anchoring of checkpoints (DESIGN.md §6.5) ---
# Off unless a witness is set. Enable with docker-compose.anchor.yml (egress +
# the TSA roots in deploy/anchor/tsa-certs.pem, which ANCHOR_RFC3161_CERTS_FILE
# points at — required whenever ANCHOR_RFC3161_URLS is set). Each TSA and the
# OpenTimestamps calendars are independent witnesses; use more than one.
#ANCHOR_RFC3161_URLS=https://freetsa.org/tsr
#ANCHOR_OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org,https://a.pool.eternitywall.com
ANCHOR_INTERVAL_SECS=3600

# --- Checkpoint signer (DESIGN.md §12.8) ---
# local  = secrets/worker_signing_key in the workers' memory (warns outside dev);
# vault  = Vault transit — docker-compose.vault.yml sets this and its VAULT_* wiring;
# pkcs11 = an HSM: PKCS11_MODULE, PKCS11_TOKEN_LABEL, PKCS11_KEY_LABEL, PKCS11_PIN_FILE.
# An external signer's public key must already be in worker_trusted_public_keys.
#WORKER_SIGNER=local

# --- KYC uploads ---
# Per-user document upload quota (rolling 24h).
KYC_UPLOAD_DAILY_MAX=20

# --- TigerBeetle ledger backend (DESIGN.md §15; deploy/README.md "TigerBeetle") ---
# docker-compose.tigerbeetle.yml sets LEDGER_BACKEND=tigerbeetle,
# TIGERBEETLE_CLUSTER_ID (from .env) and TIGERBEETLE_ADDRESSES. The rest, all
# optional, with their defaults:
#TIGERBEETLE_REQUEST_TIMEOUT_MS=5000
#TIGERBEETLE_PENDING_TIMEOUT_SECS=120
#TIGERBEETLE_RECOVERY_GRACE_SECS=10
#TIGERBEETLE_HOLD_WAIT_MS=2000
#TIGERBEETLE_SESSIONS=1
#TIGERBEETLE_RECOVERY_INTERVAL_SECS=2
