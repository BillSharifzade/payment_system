# Application settings: passed verbatim to payment-server and payment-workers
# (env_file). Copy to deploy/app.env (deploy.sh does this on first run).
#
# Every numeric value is parsed STRICTLY: a typo such as `2_000_000` makes the
# binary refuse to boot instead of silently reverting to a compiled default.
# Secrets are NOT here: DATABASE_URL, JWT_SECRET and WORKER_SIGNING_KEY arrive
# as files (DATABASE_URL_FILE etc., set by the compose files under /run/secrets).
# ---------------------------------------------------------------------------

# --- Environment ---
# Any value other than "dev" makes the binaries refuse insecure defaults (they
# require the secrets above, JWT_SECRET >= 32 chars, NATS_URL for the workers).
APP_ENV=prod
# Per-request access log lines are emitted at INFO (method, path, status, µs).
RUST_LOG=info
BIND_ADDR=0.0.0.0:8080

# --- Wiring (internal Docker network names; leave as-is) ---
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
NATS_SUBJECT_PREFIX=payments

# Behind Caddy, trust its X-Forwarded-For (right-most hop) for the rate-limit
# client identity. MUST be false on the LAN box, where clients hit :8099 directly.
TRUST_PROXY=true

# --- Timeouts (milliseconds unless noted). Every wait in the request path is bounded. ---
# Whole-request budget; a timeout answers 504 `timeout` (clients keep their
# idempotency key and retry).
REQUEST_TIMEOUT_SECS=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_IDLE_TX_TIMEOUT_MS=10000
# Connections per API replica (Postgres max_connections=200 in compose; keep
# replicas x DB_MAX_CONNECTIONS + 8 for the workers + headroom below it).
DB_MAX_CONNECTIONS=32

# --- Rate limiting (per client address per window; Redis-shared, in-memory fallback) ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECS=60
# FAILED login attempts per PHONE per window (successful logins are free).
LOGIN_LIMIT_MAX=10
LOGIN_LIMIT_WINDOW_SECS=900
# Recipient look-ups (phone -> wallet) per USER per window (anti-enumeration).
RESOLVE_LIMIT_MAX=60
RESOLVE_LIMIT_WINDOW_SECS=3600

# --- Sessions ---
# A client that rotated its refresh token but lost the response may re-present
# the old token for this many seconds and get a fresh pair. 0 = strict rotation.
REFRESH_REUSE_GRACE_SECS=30

# --- Fees (basis points; 50 = 0.50%; max 10000) ---
TRANSFER_FEE_BPS=0

# --- Biometric (fingerprint) payments — DESIGN.md §20 ---
# 32-byte hex key that seals enrolled templates at rest (AES-256-GCM). REQUIRED
# outside dev; keep it out of the database and back it up separately — without
# it every enrolment is unreadable. (or BIOMETRIC_TEMPLATE_KEY_FILE=/run/secrets/…)
BIOMETRIC_TEMPLATE_KEY=replace-with-64-hex-chars
# exact = byte-identical template lookup (dev/demo only); http = matching-engine
# sidecar implementing the §20.5 contract at BIOMETRIC_MATCHER_URL.
BIOMETRIC_MATCHER=exact
#BIOMETRIC_MATCHER_URL=http://matcher:8090
BIOMETRIC_MATCHER_TIMEOUT_MS=2000
# Decision policy: match iff best score >= threshold and the runner-up (another
# person) is either below the threshold or at least `margin` lower.
BIOMETRIC_MATCH_THRESHOLD=40
BIOMETRIC_MATCH_MARGIN=10
# Cap per fingerprint payment, minor units (200000 = 2000 TJS); AML tiers still apply.
BIOMETRIC_MAX_MINOR=200000
# Merchant check lifetime (default / maximum a terminal may request), seconds.
CHECK_TTL_SECS=300
CHECK_MAX_TTL_SECS=3600

# --- AML limits, in minor units (diram; 100 = 1 TJS). Unset => compiled defaults. ---
# Level 1 (basic KYC)
AML_L1_PER_TX_MINOR=500000
AML_L1_DAILY_MINOR=2000000
AML_L1_VELOCITY_PER_HOUR=50
# Level 2 (full KYC)
AML_L2_PER_TX_MINOR=50000000
AML_L2_DAILY_MINOR=200000000
AML_L2_VELOCITY_PER_HOUR=500

# --- Workers ---
WORKER_INTERVAL_SECS=5
# Outbox -> NATS JetStream relay cadence (its own task; a slow broker never
# blocks sealing or reconciliation).
RELAY_INTERVAL_SECS=2
SEAL_BATCH_SIZE=500
# Incremental reconciliation (accounts touched since the last healthy pass)
# every RECONCILE_INTERVAL_SECS; a FULL re-derivation of every account every
# RECONCILE_FULL_EVERY_SECS (default daily).
RECONCILE_INTERVAL_SECS=60
RECONCILE_FULL_EVERY_SECS=86400
VERIFY_INTERVAL_SECS=300
RETENTION_INTERVAL_SECS=86400
# Retention windows (days) for operational tables. The ledger itself and the
# compliance audit trails (screening_events, admin_actions) are never pruned.
RETENTION_OUTBOX_DAYS=7
RETENTION_IDEMPOTENCY_DAYS=30
RETENTION_REFRESH_TOKENS_DAYS=30
# Uploaded KYC documents never cited by any submission are deleted after this
# many days (documents referenced by a submission are kept forever).
RETENTION_KYC_ORPHAN_DAYS=7

# --- KYC uploads ---
# Per-user document upload quota (rolling 24h).
KYC_UPLOAD_DAILY_MAX=20
