-- Application roles (psql script; NOT run by the postgres entrypoint, which
-- only executes *.sh / *.sql in /docker-entrypoint-initdb.d).
--
-- Expects psql variables owner_pw, app_pw, backup_pw, monitor_pw and dbname:
--   10-roles.sh sets them with \getenv from secret files inside the container;
--   upgrade-hardening.sh sets them with \set on psql's stdin.
-- Idempotent; run as the bootstrap superuser.

SET client_min_messages = warning;   -- re-runs: no "already a member" notices

SELECT format('CREATE ROLE %I', r)
FROM unnest(ARRAY['payment_owner', 'payment_app', 'payment_backup', 'payment_monitor']) AS r
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = r)
\gexec

-- Attributes are (re)asserted on every run: none of these may ever be a
-- superuser, create roles/databases, replicate or bypass row security.
ALTER ROLE payment_owner   WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS INHERIT PASSWORD :'owner_pw';
ALTER ROLE payment_app     WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS INHERIT PASSWORD :'app_pw';
ALTER ROLE payment_backup  WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS INHERIT PASSWORD :'backup_pw';
ALTER ROLE payment_monitor WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS INHERIT PASSWORD :'monitor_pw';

GRANT pg_read_all_data TO payment_backup;
GRANT pg_monitor TO payment_monitor;

-- The runtime and owner roles must not inherit anything beyond their own grants.
SELECT format('REVOKE %I FROM %I', b.rolname, r.rolname)
FROM pg_auth_members m
JOIN pg_roles r ON r.oid = m.member
JOIN pg_roles b ON b.oid = m.roleid
WHERE r.rolname IN ('payment_app', 'payment_owner')
\gexec

-- payment_owner owns the database, so (as pg_database_owner) it owns schema
-- public and is the only non-superuser allowed to CREATE in it.
SELECT format('ALTER DATABASE %I OWNER TO payment_owner', :'dbname')
WHERE (SELECT pg_get_userbyid(datdba) FROM pg_database WHERE datname = :'dbname') <> 'payment_owner'
\gexec

SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'dbname') \gexec
SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO payment_app', :'dbname') \gexec
SELECT format('GRANT CONNECT ON DATABASE %I TO payment_backup, payment_monitor', :'dbname') \gexec
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
